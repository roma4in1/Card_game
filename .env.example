# Copy this file to `.env` and fill in the password. `.env` is gitignored; this one is not,
# so never put a real password here.
#
#   cp .env.example .env
#   npm run db:check      # confirms the connection and creates the table
#
# Without DATABASE_URL the server writes match records to data/matches.jsonl instead, which
# is fine locally and useless once deployed — a container's disk is wiped on every restart.

# Supabase → Connect → *Session pooler*. Use that one, not "direct connection": the direct
# db.*.supabase.co host is IPv6-only, and most networks (including a lot of hosting) have
# no route to it, so it simply will not resolve. The pooler stores exactly the same rows.
#
# Its username carries the project ref — postgres.PROJECT_REF, not plain postgres:
#   postgresql://postgres.PROJECT_REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres
#
# Replace [YOUR-PASSWORD] with the DATABASE password (not your Supabase account password).
# If it contains @ : / ? # or %, percent-encode it (@ becomes %40) or the URL will not parse.
DATABASE_URL=postgresql://postgres.qfggimzviyycxzvgnrag:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:5432/postgres

# Optional: where records go when there is no database (default data/matches.jsonl)
# TELEMETRY_FILE=data/matches.jsonl

# Optional: set to `off` to record nothing at all
# TELEMETRY=on

# Optional: fixes the salt used to hash room codes. Unset means a new salt each restart,
# so records stay linkable within a run but never across restarts. Set it only if you want
# to follow a room across restarts — it is a secret, and it belongs in .env, not here.
# TELEMETRY_SALT=
